<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="20dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <ImageView
        android:id="@+id/joke_imv"
        android:layout_width="0dp"
        android:layout_height="100dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:background="@color/white"
        tools:src="@drawable/placeholder"/>

    <TextView
        android:id="@+id/joke_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginVertical="5dp"
        android:layout_marginStart="16dp"
        android:textSize="17sp"
        android:textColor="@color/dark_bg"
        android:textStyle="italic"
        android:maxLines="4"
        android:ellipsize="end"
        app:layout_constraintTop_toTopOf="@id/joke_imv"
        app:layout_constraintStart_toEndOf="@id/joke_imv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/joke_imv"
        tools:text="Lorem ipsum akjdskm Lorem ipsum akjdskmLorem ipsum
        akjdskmLorem ipsum akjdskmLorem ipsum akjdskmLorem ipsum akjdskmLorem
        ipsum akjdskmLorem ipsum akjdskm"/>
</androidx.constraintlayout.widget.ConstraintLayout>